# Port du serveur backend
PORT=5000

# Connexion PostgreSQL pour Drizzle ORM
# Format : postgres://UTILISATEUR:MOTDEPASSE@HOTE:PORT/NOM_BDD
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portfolio_bautzen

# Clé secrète JWT pour l'authentification de la plateforme administrative
JWT_SECRET=super_secret_jwt_key_bautzen_portfolio_2026_dev_key

# Origine Frontend autorisée (CORS)
FRONTEND_URL=http://localhost:5173

